# ──────────────────────────────────────────────
# কুমিরা বাস বন্ধু — Environment Variables Template
# ──────────────────────────────────────────────
# এই ফাইল কপি করে .env নামে সেভ করুন:
#   cp .env.example .env        (Mac/Linux)
#   copy .env.example .env      (Windows)
#
# ⚠️  .env ফাইল কখনো GitHub এ push করবেন না!
# ──────────────────────────────────────────────

# ──── Gemini API ────
# https://aistudio.google.com থেকে API key নিন
GEMINI_API_KEY=your_gemini_api_key_here

# ──── Gemma মডেল ────
# AI Studio → Models থেকে exact model ID কপি করুন
# উদাহরণ: gemma-3-27b-it, gemma-3-12b-it, gemma-3-4b-it
GEMMA_MODEL=gemma-3-27b-it

# ──── Whisper STT ────
# Model size: tiny | base | small | medium | large | large-v3
# বাংলা accuracy: small < medium < large-v3 (কিন্তু large-v3 বেশি ধীর ও বড়)
WHISPER_SIZE=small

# Whisper ভাষা (bn = বাংলা)
WHISPER_LANGUAGE=bn

# ──── App সেটিং ────
# Gradio server port (ডিফল্ট: 7860)
PORT=7860
